# Example environment for /data/quasar/deepseek-bridge/bridge.env
# Copy values to bridge.env on the station; do not commit secrets.

# BRIDGE_MODE=hybrid
# BRIDGE_PIPELINE=1
# JOBS_DB_PATH=/data/quasar/deepseek-bridge/data/jobs.db
# BRIDGE_JOB_MODEL=deepseek-chat
# BRIDGE_JOB_MAX_TOOL_ROUNDS=24
# BRIDGE_JOB_STEP_TIMEOUT_SEC=120
# BRIDGE_JOB_MAX_API_CALLS=16
# BRIDGE_JOB_MAX_API_CALLS_TOTAL=48
# BRIDGE_JOB_MAX_INTROSPECTIONS=3
# BRIDGE_MAX_CONCURRENT_JOBS=1
# BRIDGE_PIPELINE_STUB_WORKER=0
# HA_URL=http://127.0.0.1:8123
