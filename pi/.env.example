WINDOWS_HOST=192.168.1.211
PCM_PORT=9700
CONTROL_PORT=9701
WAKE_WORDS=компьютер,джарвис,прослушка
COMMAND_WINDOW_SEC=10
# Pause after STT "final" before running the command (cancelled if speech continues)
STT_COMMAND_COMMIT_SEC=1.0
# Периодическая проверка Windows STT/TTS (сек); при сбое — reload_modules
WINDOWS_HEALTH_INTERVAL_SEC=600
ARECORD_DEVICE=plughw:Device,0
APLAY_DEVICE=default
# Громкость: set_speaker_volume (APLAY) и set_mic_volume (ARECORD), 0–100
# SPEAKER_ALSA_CONTROL=Speaker
# MIC_ALSA_CONTROL=Mic
# Перед стартом jarvis-pi (install-service.sh): USB-карта по умолчанию и уровни после ребута
MIC_BOOT_PERCENT=45
SPEAKER_BOOT_PERCENT=50
SAMPLE_RATE=16000
# Full-duplex TTS: AEC (webrtc|off). Wake во время ответа — тот же STT на Windows.
# AEC_BACKEND=webrtc
# AEC_STREAM_DELAY_MS=80
# BARGE_IN_ENABLED=true
# NEAR_END_RMS_THRESHOLD=400
# AUDIO_INPUT_DEVICE=
# AUDIO_OUTPUT_DEVICE=
LOCATION_CITY=Ульяновск
LOCATION_DISTRICT=Ленинский
LOCATION_TZ=Europe/Samara
DEEPSEEK_API_KEY=
# Responses API (не chat/completions): deepseek-flash или deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_RESPONSES_URL=https://api.deepseek.com/responses
DEEPSEEK_REASONING=false
# DEEPSEEK_REASONING_EFFORT=low
# Таймеры (set_timer): в процессе jarvis-pi; звонок до TIMER_RING_DURATION_SEC (по умолчанию 300)
# TIMER_RING_DURATION_SEC=300
# Долговременная память (SQLite FTS5, каталог pi/data/ по умолчанию)
# MEMORY_DB_PATH=pi/data/memory.db
MEMORY_SESSION_TIMEOUT_SEC=1800
# MEMORY_HOT_HOURS=3
# MEMORY_WARM_DAYS=7
# Home Assistant на этой же машине. Долгоживущий токен: профиль → безопасность.
HA_URL=http://127.0.0.1
HA_TOKEN=
