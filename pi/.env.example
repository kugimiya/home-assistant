WINDOWS_HOST=192.168.1.211
PCM_PORT=9700
CONTROL_PORT=9701
WAKE_WORDS=компьютер,джарвис,прослушка
COMMAND_WINDOW_SEC=10
# Pause after STT "final" before running the command (cancelled if speech continues)
STT_COMMAND_COMMIT_SEC=1.0
ARECORD_DEVICE=plughw:Device,0
APLAY_DEVICE=default
SAMPLE_RATE=16000
LOCATION_CITY=Ульяновск
LOCATION_DISTRICT=Ленинский
LOCATION_TZ=Europe/Samara
DEEPSEEK_API_KEY=
# Responses API (не chat/completions): deepseek-flash или deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_RESPONSES_URL=https://api.deepseek.com/responses
DEEPSEEK_REASONING=false
# DEEPSEEK_REASONING_EFFORT=low
# Таймеры (set_timer): sudo apt install at && sudo systemctl enable --now atd
