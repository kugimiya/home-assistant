PCM_LISTEN_HOST=0.0.0.0
PCM_LISTEN_PORT=9700
CONTROL_LISTEN_HOST=0.0.0.0
CONTROL_LISTEN_PORT=9701
VOSK_MODEL_PATH=models/vosk-model-ru-0.42
PIPER_BIN=third_party/piper/piper.exe
PIPER_MODEL=models/ru_RU-irina-medium.onnx
PIPER_CONFIG=models/ru_RU-irina-medium.onnx.json
SAMPLE_RATE=16000
# Vosk endpointer: LONG/VERY_LONG, trailing silence before "final" (seconds)
VOSK_ENDPOINT_MODE=long
VOSK_ENDPOINT_TRAILING_SEC=1.2
VOSK_ENDPOINT_START_MAX_SEC=5.0
VOSK_ENDPOINT_MAX_UTTERANCE_SEC=30.0
# Reset STT if no PCM from Pi for this many seconds (was hardcoded 0.35)
PCM_UPLINK_GAP_RESET_SEC=1.0
